. 
. // (G) Full 4-way interaction - All outcomes
. foreach y of local outcomes {
  2.     eststo G_`y'_pooled: reghdfe `y' i.treat_quake##i.post_quake##i.base_inc##i.age_group, `absorb_spec'
  3.     estadd local model "G: Full DDDD (income × age)", replace
  4.     estadd local depvar "`y'", replace
  5.     
.     * Subgroup regressions by income and age combinations
.     forvalues c = 1/3 {
  6.         forvalues a = 1/3 {
  7.             capture eststo G_`y'_inc`c'_age`a': reghdfe `y' i.treat_quake##i.post_quake ///
>                 if base_inc == `c' & age_group == `a', `absorb_spec'
  8.             if !_rc {
  9.                 estadd local model "G: DiD within inc=`c', age=`a'", replace
 10.                 estadd local depvar "`y'", replace
 11.             }
 12.         }
 13.     }
 14. }
