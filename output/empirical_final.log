. foreach y of local outcomes {
  2.     // (R1) Different treatment timing (use 2002 vs 2003)
.     gen byte post_quake_2002 = (year >= 2002)
  3.     eststo R1_`y': reghdfe `y' i.post_quake_2002##i.treat_quake, ///
>         absorb(year region_res) vce(cluster id_worker)
  4.     drop post_quake_2002
  5.     
.     // (R2) Exclude transition year (drop 2002)
.     eststo R2_`y': reghdfe `y' i.post_quake##i.treat_quake if year != 2002, ///
>         absorb(year region_res) vce(cluster id_worker)
  6.     
.     // (R3) Balanced panel only
.     bys id_worker: gen n_obs = _N
  7.     eststo R3_`y': reghdfe `y' i.post_quake##i.treat_quake if n_obs == 5, ///
>         absorb(year region_res) vce(cluster id_worker)
  8.     drop n_obs
  9. }
