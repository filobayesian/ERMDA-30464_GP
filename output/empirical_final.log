. 
. // (F) Age heterogeneity - All outcomes
. foreach y of local outcomes {
  2.     eststo F_`y'_pooled: reghdfe `y' i.treat_quake##i.post_quake##i.age_group, `absorb_spec'
  3.     estadd local model "F: Age heterogeneity DDD", replace
  4.     estadd local depvar "`y'", replace
  5.     
.     forvalues a = 1/3 {
  6.         eststo F_`y'_age`a': reghdfe `y' i.treat_quake##i.post_quake if age_group == `a', `absorb_spec'
  7.         estadd local model "F: DiD within age group `a'", replace
  8.         estadd local depvar "`y'", replace
  9.     }
 10. }
