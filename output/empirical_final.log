. 
. // (E) Current income category - All outcomes
. foreach y of local outcomes {
  2.     eststo E_`y'_pooled: reghdfe `y' i.treat_quake##i.post_quake##i.income_category_worker, `absorb_spec'
  3.     estadd local model "E: Income category DDD", replace
  4.     estadd local depvar "`y'", replace
  5.     
.     forvalues c = 1/3 {
  6.         eststo E_`y'_cat`c': reghdfe `y' i.treat_quake##i.post_quake if income_category_worker == `c', `absorb_spec'
  7.         estadd local model "E: DiD within income cat `c'", replace
  8.         estadd local depvar "`y'", replace
  9.     }
 10. }
