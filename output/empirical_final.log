. *============================*
. * PACKAGE INSTALLATION       *
. *============================*
. local packages ftools reghdfe estout coefplot parmest

. foreach pkg of local packages {
  2.     cap which `pkg'
  3.     if _rc ssc install `pkg', replace
  4. }

. 
. *============================*
. *       LOAD DATA            *
. *============================*
. local regions molise basilicata

. local first = 1

. foreach r of local regions {
  2.     if `first' {
  3.         use "Data/non_derived/`r'.dta", clear
  4.         local first = 0
  5.     }
  6.     else append using "Data/non_derived/`r'.dta"
  7. }
(Written by R.              )
(variable date_end was int, now float to accommodate using data's values)
(label type already defined)
(label sector_firm already defined)
(label firm_dimension already defined)
(label firm_position already defined)
(label region_res already defined)
(label gender already defined)
(label qualification already defined)
(label type_contract already defined)
(label part_time already defined)
(label reason_end2 already defined)

. 
. *============================*
. *  DATA CLEANING & ENGINEERING *
. *============================*
. 
. keep id_worker year gender type wage contract_type sector_12cat region_res year_birth

. 
. destring region_res, replace
region_res already numeric; no replace

. 
. * For each worker, find their region (use mode in case of moves)
. bysort id_worker: egen region_filled = mode(region_res), maxmode
warning: For at least one group, region_res contains all missing values. Generating missing values for the modes in these groups. Use
         option missing to treat missing values as a category.
(6,563 missing values generated)

. replace region_res = region_filled if missing(region_res)
(391,428 real changes made)

. drop region_filled

. 
. * Verify the fix
. di _n "=== VERIFY: Unemployed workers now have region ===" _n

=== VERIFY: Unemployed workers now have region ===


. tab type region_res if type == 4

                  |  Region of residence
             type | Basilicat     Molise |     Total
------------------+----------------------+----------
     Non employed |   257,085    134,343 |   391,428 
------------------+----------------------+----------
            Total |   257,085    134,343 |   391,428 

. 
. *--- Treatment Variables ---*
. gen byte treat_quake = (region_res == 12)

. label var treat_quake "Molise resident"

. 
. *--- Wage Processing ---*
. destring wage, replace force
wage already numeric; no replace

. label var wage "Annual wage (€)"

. 
. *--- Log wage (create early for use throughout) ---*
. gen double lnwage = ln(wage + 1)
(397,991 missing values generated)

. label var lnwage "Log(wage + 1)"

. 
. *--- Employment Indicator ---*
. gen byte employed = (wage > 0 & !missing(wage)) | (type != 4 & !missing(type))

. replace employed = . if missing(wage) & missing(type)
(0 real changes made)

. label var employed "Any employment"

. 
. *--- Cohort Filtering ---*
. preserve

. keep if inlist(year, 1999, 2000, 2001, 2002) & employed == 1
(802,540 observations deleted)

. keep id_worker

. duplicates drop

Duplicates in terms of all variables

(35,047 observations deleted)

. di "Cohort size: " _N
Cohort size: 16457

. tempfile cohort_workers

. save `cohort_workers'
file /var/folders/yt/tw36rldj4vj59zcpt_d9sjww0000gn/T//S_26055.000002 saved as .dta format

. restore

. 
. merge m:1 id_worker using `cohort_workers', keep(match) nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           484,601  
    -----------------------------------------

. keep if inrange(year, 2000, 2004)
(404,957 observations deleted)

. 
. *--- Post-treatment indicator ---*
. gen byte post_quake = (year >= 2003)

. label var post_quake "Post 2003"

. 
. gen rel_year = year - 2002

. label var rel_year "Year - 2002"

. 
. *--- Age calculation and age groups ---*
. gen age = year - year_birth

. label var age "Age in given year"

. 
. gen byte age_group = .
(79,644 missing values generated)

. replace age_group = 1 if age <= 34 & !missing(age)
(32,905 real changes made)

. replace age_group = 2 if age >= 35 & age <= 55 & !missing(age)
(42,758 real changes made)

. replace age_group = 3 if age >= 56 & !missing(age)
(3,981 real changes made)

. 
. label define age_grp 1 "≤34" 2 "35-55" 3 "≥56"

. label values age_group age_grp

. label var age_group "Age group"

. 
. *--- Worker-level average wage ---*
. bysort id_worker: egen avg_wage_worker = mean(wage)
(2,015 missing values generated)

. label var avg_wage_worker "Worker-level average wage"

. 
. *--- Worker-level Income Category ---*
. gen byte income_category_worker = .
(79,644 missing values generated)

. replace income_category_worker = 1 if avg_wage_worker < 28000 & !missing(avg_wage_worker)
(72,714 real changes made)

. replace income_category_worker = 2 if avg_wage_worker >= 28000 & avg_wage_worker <= 50000
(3,848 real changes made)

. replace income_category_worker = 3 if avg_wage_worker > 50000 & !missing(avg_wage_worker)
(1,067 real changes made)

. 
. label define inc_cat_w 1 "Low" 2 "Medium" 3 "High"

. label values income_category_worker inc_cat_w

. label var income_category_worker "Income category (worker avg)"

. 
. *--- Current Income Category ---*
. gen byte income_category = .
(79,644 missing values generated)

. replace income_category = 1 if wage < 28000 & !missing(wage)
(59,648 real changes made)

. replace income_category = 2 if inrange(wage, 28000, 50000)
(4,233 real changes made)

. replace income_category = 3 if wage > 50000
(15,763 real changes made)

. 
. label define inc3 1 "Low" 2 "Medium" 3 "High"

. label values income_category inc3

. label var income_category "Income category (current year)"

. 
. *--- Baseline Income ---*
. gen byte pre = (post_quake == 0)

. bys id_worker: egen pre_last_year = max(year) if pre
(31,407 missing values generated)

. gen double baseline_wage = wage if year == pre_last_year
(65,722 missing values generated)

. bys id_worker: egen baseline_wage_final = max(baseline_wage)
(11,569 missing values generated)

. drop baseline_wage pre pre_last_year

. rename baseline_wage_final baseline_wage

. label var baseline_wage "Baseline wage (last pre-quake year)"

. 
. gen byte base_inc = 1 if baseline_wage < 28000 & !missing(baseline_wage)
(16,721 missing values generated)

. replace base_inc = 2 if inrange(baseline_wage, 28000, 50000)
(4,059 real changes made)

. replace base_inc = 3 if baseline_wage > 50000 & !missing(baseline_wage)
(1,093 real changes made)

. 
. gen byte base_inc4 = cond(missing(base_inc), 4, base_inc)

. label define baseinc4 1 "Low (pre)" 2 "Med (pre)" 3 "High (pre)" 4 "Unknown (pre)"

. label values base_inc4 baseinc4

. label var base_inc4 "Baseline income (4 cats incl. Unknown)"

. 
. *--- Employment Type Dummies ---*
. gen byte y_private = (type == 1) if !missing(type)

. gen byte y_public  = (type == 2) if !missing(type)

. gen byte y_self    = (type == 3) if !missing(type)

. 
. label var y_private "Private employment (Pr)"

. label var y_public  "Public employment (Pr)"

. label var y_self    "Self-employment (Pr)"

. 
. *--- Labels ---*
. label define trt 0 "Control" 1 "Molise"

. label values treat_quake trt

. 
. 
. *============================*
. *  BASELINE TRAJECTORY PLOTS *
. *============================*
. 
. *--- Overall: Employment, Wage, and Log Wage (Δ vs 2000) ---*
. preserve

. keep year treat_quake employed wage lnwage

. drop if missing(year) | missing(treat_quake)
(0 observations deleted)

. collapse (mean) mean_emp=employed mean_wage=wage mean_lnwage=lnwage, by(treat_quake year)

. 
. * Use 2000 as baseline
. bys treat_quake: egen base_emp = total(mean_emp * (year==2000))

. bys treat_quake: egen base_wage = total(mean_wage * (year==2000))

. bys treat_quake: egen base_lnwage = total(mean_lnwage * (year==2000))

. 
. gen mean_emp_rel = mean_emp - base_emp

. gen mean_wage_rel = mean_wage - base_wage

. gen mean_lnwage_rel = mean_lnwage - base_lnwage

. 
. twoway ///
>  (line mean_emp_rel year if treat_quake==0, lcolor(blue) m(o)) ///
>  (line mean_emp_rel year if treat_quake==1, lcolor(red) m(o)), ///
>  ytitle("Employment Rate (Δ vs 2000)") xtitle("Year") ///
>  xline(2002.5, lpattern(dash) lcolor(black)) ///
>  legend(order(1 "Control" 2 "Molise") pos(6) rows(1)) ///
>  title("Parallel Trends: Employment") ///
>  xlabel(2000(1)2004) ///
>  name(g_emp, replace)

. 
. twoway ///
>  (line mean_wage_rel year if treat_quake==0, lcolor(blue) m(o)) ///
>  (line mean_wage_rel year if treat_quake==1, lcolor(red) m(o)), ///
>  ytitle("Wage (Δ vs 2000, €)") xtitle("Year") ///
>  xline(2002.5, lpattern(dash) lcolor(black)) ///
>  legend(order(1 "Control" 2 "Molise") pos(6) rows(1)) ///
>  title("Parallel Trends: Wage") ///
>  xlabel(2000(1)2004) ///
>  name(g_wage, replace)

. 
. twoway ///
>  (line mean_lnwage_rel year if treat_quake==0, lcolor(blue) m(o)) ///
>  (line mean_lnwage_rel year if treat_quake==1, lcolor(red) m(o)), ///
>  ytitle("Log(Wage) (Δ vs 2000)") xtitle("Year") ///
>  xline(2002.5, lpattern(dash) lcolor(black)) ///
>  legend(order(1 "Control" 2 "Molise") pos(6) rows(1)) ///
>  title("Parallel Trends: Log Wage") ///
>  xlabel(2000(1)2004) ///
>  name(g_lnwage, replace)

. 
. graph combine g_emp g_wage g_lnwage, rows(3) imargin(tiny)

. graph export "$OUT/traj_overall_all_outcomes.png", replace
file /Users/vittoriogaravelli/GitHub/GitHub/ERMDA-30464_GP/output/traj_overall_all_outcomes.png saved as PNG format

. restore

. 
. *--- By employment type: Private/Public/Self ---*
. foreach k in 1 2 3 {
  2.     if `k'==1 local kname "private"
  3.     if `k'==2 local kname "public"
  4.     if `k'==3 local kname "self"
  5.     
.     preserve
  6.     keep year treat_quake employed wage lnwage type
  7.     drop if missing(year) | missing(treat_quake)
  8.     gen emp_`kname' = (type==`k')
  9.     gen wage_`kname' = wage if type==`k'
 10.     gen lnwage_`kname' = lnwage if type==`k'
 11.     collapse (mean) mean_emp=emp_`kname' mean_wage=wage_`kname' mean_lnwage=lnwage_`kname', by(treat_quake year)
 12.     bys treat_quake: egen base_emp = total(mean_emp * (year==2001))
 13.     bys treat_quake: egen base_wage = total(mean_wage * (year==2001))
 14.     bys treat_quake: egen base_lnwage = total(mean_lnwage * (year==2001))
 15.     gen mean_emp_rel = mean_emp - base_emp
 16.     gen mean_wage_rel = mean_wage - base_wage
 17.     gen mean_lnwage_rel = mean_lnwage - base_lnwage
 18.     local K = proper("`kname'")
 19.     
.     #delimit ;
delimiter now ;
.     twoway (line mean_emp_rel year if treat_quake==0, msymbol(o))
>            (line mean_emp_rel year if treat_quake==1, msymbol(o)),
>            ytitle("Employment (Δ vs 2001)") xtitle("Year")
>            xline(2002, lpattern(dash))
>            legend(order(1 "Control" 2 "Molise"))
>            title("Parallel Trends: `K' Employment")
>            name("g_emp_`kname'", replace) ;
 20.     twoway (line mean_wage_rel year if treat_quake==0, msymbol(o))
>            (line mean_wage_rel year if treat_quake==1, msymbol(o)),
>            ytitle("Wage (Δ vs 2001, €)") xtitle("Year")
>            xline(2002, lpattern(dash))
>            legend(order(1 "Control" 2 "Molise"))
>            title("Parallel Trends: `K' Wage")
>            name("g_wage_`kname'", replace) ;
 21.     graph combine g_emp_`kname' g_wage_`kname', rows(2) imargin(tiny) ;
 22.     graph export "$OUT/traj_`kname'_emp_wage.png", replace ;
 23.     #delimit cr
delimiter now cr
.     restore
 24. }
