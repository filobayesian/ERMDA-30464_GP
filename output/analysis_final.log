. *============================*
. *   EVENT STUDY (Figure 3)   *
. *============================*
. 
. preserve

. keep if inrange(rel_year, -2, 2)
(0 observations deleted)

. 
. cap drop event_*

. forval k = -2/2 {
  2.     if `k' != 0 {
  3.         local suffix = cond(`k' < 0, "m" + string(abs(`k')), string(`k'))
  4.         gen byte event_`suffix' = (rel_year == `k' & treat_quake == 1)
  5.     }
  6. }

