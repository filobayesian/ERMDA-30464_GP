. foreach y of local outcomes {
  2.     // (P1) Placebo treatment year (pretend shock was in 2001)
.     gen byte fake_post = (year >= 2001)
  3.     eststo P1_`y': reghdfe `y' i.fake_post##i.treat_quake if year <= 2002, ///
>         absorb(year region_res) vce(cluster id_worker)
  4.     estadd local model "P1: Placebo 2001", replace
  5.     drop fake_post
  6.     
.     // (P2) Randomization test: assign treatment to random workers
.     set seed 12345
  7.     gen random_treat = runiform() > 0.5
  8.     eststo P2_`y': reghdfe `y' i.post_quake##i.random_treat, ///
>         absorb(year region_res) vce(cluster id_worker)
  9.     estadd local model "P2: Random treatment", replace
 10.     drop random_treat
 11. }
