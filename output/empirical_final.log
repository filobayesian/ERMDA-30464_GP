. cap coefplot ///
>     (A_employed, keep(1.treat_quake#1.post_quake) label("Employment")) ///
>     (A_wage, keep(1.treat_quake#1.post_quake) label("Wage")) ///
>     (A_lnwage, keep(1.treat_quake#1.post_quake) label("Log Wage")), ///
>     vertical xline(0, lp(dash)) ciopts(recast(rcap)) ///
>     title("A — Main Treatment Effects Across Outcomes") ytitle("Coefficient") xtitle("")

