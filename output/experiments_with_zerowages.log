. * Create coefficient plot for all income-age combinations
. local plot_list ""

. local label_list ""

. local counter = 1

. forvalues c = 1/3 {
  2.     forvalues a = 1/3 {
  3.         capture confirm variable e(sample) in 1 using G_inc`c'_age`a'
  4.         if !_rc {
  5.             local inc_label: label inc3 `c'
  6.             local age_label: label age_grp `a'
  7.             local plot_list `"`plot_list' (G_inc`c'_age`a', keep(1.treat_quake#1.post_quake) label("`inc_label', `age_label'"))"'
