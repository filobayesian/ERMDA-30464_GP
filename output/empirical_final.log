. *============================*
. *    REGRESSION ANALYSES     *
. *============================*
. local outcomes employed wage lnwage

. local absorb_spec absorb(year region_res) vce(cluster id_worker)

. 
. // (A) Main DiD - All three outcomes
. foreach y of local outcomes {
  2.     qui count if !missing(`y')
  3.     if r(N) > 0 {
  4.         eststo A_`y': reghdfe `y' i.post_quake##i.treat_quake, `absorb_spec'
  5.         estadd local model "A: Main DiD", replace
  6.         estadd local depvar "`y'", replace
  7.     }
  8. }
